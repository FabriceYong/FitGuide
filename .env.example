# Settings for `docker compose`. Copy to .env (next to docker-compose.yml);
# every line is optional. Changing a port or key needs `docker compose up -d --build`.

# Host ports
# WEB_PORT=3000
# APP_PORT=8080
# API_PORT=5001
# DB_PORT=5432

# Random string, at least 32 characters. A fixed local-only value is used
# when unset; set your own if the stack is reachable by anyone else.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=

# Unsplash key for the website's dynamic workout images
# NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=

# Other API keys (ANTHROPIC_API_KEY, Stripe, Strava, Fitbit, ...) go in
# fitguide_api/.env, which the api container also reads.
