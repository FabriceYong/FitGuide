<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- FitGuide is dark whatever the system setting, so light and dark mode
         use the same dark launch window: no white flash before the first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Shown until the Flutter engine draws its first frame. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- The window behind the Flutter UI while it initializes and runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/fitguide_background</item>
    </style>
</resources>
