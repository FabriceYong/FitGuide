# Copy to .env and fill in. Never commit .env.

# Server port
PORT=5001

# Required. Random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# MongoDB connection string. If unreachable, the API falls back to a local
# JSON mock database (development only).
MONGODB_URI=mongodb://localhost:27017/fitguide

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# WorkoutX exercise API, proxied through /api/exercise-library (optional)
WORKOUTX_API_KEY=
WORKOUTX_API_BASE=https://workoutxapp.com/v1

# Set to true to mount destructive dev-only routes (POST /api/workouts/seed)
ENABLE_DEV_ROUTES=false

# Optional: path for the mock database file (defaults to ./mock_db_data.json)
# MOCK_DB_PATH=
