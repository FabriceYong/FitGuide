# Copy to .env and fill in. Never commit .env.

# Server port
PORT=5001

# Required. Random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Required. PostgreSQL connection string.
# Local development without Docker: run `npm run db:dev` in another terminal;
# it prints this URL (port 5433 by default, DEV_DB_PORT to change it).
# With Docker: `docker compose up -d db` from the repo root, then use
#   postgresql://fitguide:fitguide@localhost:5432/fitguide?schema=public
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/fitguide?schema=public

# Accounts to make admins whenever the API starts (comma separated). Only
# accounts that already exist are changed: sign up first, then restart the
# API. Removing an email here doesn't remove the role; do that in Admin → Users.
# ADMIN_EMAILS=you@example.com

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth cookie. 'lax' works when the web app and API share a site (e.g. both on
# localhost, or app.example.com + api.example.com). Use 'none' only for
# different sites; it requires HTTPS. Secure defaults to on when
# NODE_ENV=production.
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
# Share the cookies between subdomains (e.g. app.example.com + api.example.com)
# so the web app's server can see the session hint and keep private pages private.
# COOKIE_DOMAIN=.example.com

# Session lengths. The access token is short-lived and renewed with the refresh
# token (POST /api/auth/refresh); each refresh token can be used once.
# ACCESS_TOKEN_TTL_SEC=900
# REFRESH_TOKEN_TTL_DAYS=30

# Rate limits (requests per window, per client IP). Login counts failed
# attempts per 15 min, register counts accounts per hour, API is per 15 min.
# LOGIN_RATE_LIMIT_MAX=10
# REGISTER_RATE_LIMIT_MAX=10
# API_RATE_LIMIT_MAX=1000
# Forgot-password emails per 15 min.
# RESET_RATE_LIMIT_MAX=5
# Set when running behind a reverse proxy so limits use the client IP.
# TRUST_PROXY=1

# Email, for "forgot password" links. Any SMTP service works (Resend,
# Postmark, SendGrid, Mailgun, Amazon SES...). Without SMTP_URL, development
# servers print each email to the console instead, links included; production
# sends nothing. The links point at WEB_APP_URL (below) or the first CORS origin.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=FitGuide <no-reply@example.com>

# WorkoutX exercise API, proxied through /api/exercise-library (optional)
WORKOUTX_API_KEY=
WORKOUTX_API_BASE=https://workoutxapp.com/v1

# rss2json, proxied through /api/articles for the home tab's live articles
# (optional; works without a key at a lower rate limit)
RSS2JSON_API_KEY=

# Set to true to mount dev-only routes (POST /api/workouts/seed)
ENABLE_DEV_ROUTES=false

# Uploaded images (avatars, progress photos). 'local' keeps them in UPLOADS_DIR
# (default ./uploads) and serves them at /uploads. Use 's3' in production with
# any S3-compatible bucket: AWS S3, Cloudflare R2, MinIO, ...
STORAGE_DRIVER=local
# UPLOADS_DIR=
# S3_BUCKET=
# S3_PUBLIC_URL=https://cdn.example.com
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# AI coach (/api/coach). Without a key the coach shows as unavailable.
ANTHROPIC_API_KEY=
# COACH_MODEL=claude-opus-5-5
# COACH_EFFORT=low
# COACH_MESSAGES_PER_HOUR=30

# Wearables. A service shows as available once its client id and secret are
# set. Register this callback URL with each provider:
#   <API_PUBLIC_URL>/api/integrations/<strava|fitbit>/callback
# API_PUBLIC_URL=http://localhost:5001
# Where to send the browser back after connecting (defaults to the first CORS origin)
# WEB_APP_URL=http://localhost:3000
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# FITBIT_CLIENT_ID=
# FITBIT_CLIENT_SECRET=
# 32 random bytes (64 hex chars) for encrypting provider tokens. Required in
# production; in development it is derived from JWT_SECRET.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TOKEN_ENCRYPTION_KEY=

# FitGuide PLUS (Stripe). Billing turns on when the secret key and at least
# one price are set. Use test-mode keys (sk_test_...) until launch.
# Webhook endpoint: <API_PUBLIC_URL>/api/billing/webhook with the events
# checkout.session.completed and customer.subscription.created/updated/deleted.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...
# Free accounts' daily coach messages (PLUS has only the hourly limit)
# COACH_FREE_MESSAGES_PER_DAY=10
# The exercise GIFs (ExerciseDB/AscendAPI) are licensed for non-commercial use
# only, so they switch off while billing is on. Set this only once you have a
# commercial licence or your own media.
# EXERCISE_GIFS_LICENSED=false
