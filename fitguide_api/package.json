{
  "name": "fitguide_api",
  "version": "1.0.0",
  "description": "FitGuide backend API (Express + PostgreSQL via Prisma)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test \"test/*.test.js\"",
    "postinstall": "prisma generate",
    "db:dev": "node scripts/devDb.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node seed/index.js",
    "assign-gifs": "node scripts/assignExerciseGifs.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1153.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "prisma": "6.19.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "embedded-postgres": "18.4.0-beta.17",
    "nodemon": "^3.1.4",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
