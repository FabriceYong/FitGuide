// FitGuide database schema (PostgreSQL).
// Change it with `npm run db:migrate -- --name <change>`, which writes a new
// migration under prisma/migrations. Catalog content (workouts, exercises,
// programs) is loaded from seed/ by `npm run db:seed`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Accounts ────────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(uuid())
  name               String    @db.VarChar(100)
  email              String    @unique
  passwordHash       String
  // Set once the user follows the link emailed at sign-up (or a password
  // reset link). Accounts can't sign in before.
  emailVerifiedAt    DateTime?
  // Allowed values for the profile fields live in utils/enums.js.
  gender             String    @default("Prefer not to say")
  height             Float     @default(170)
  weight             Float     @default(70)
  targetWeight       Float     @default(70)
  fitnessLevel       String    @default("Beginner")
  activityStatus     String    @default("Active")
  goal               String    @default("Vitality")
  diet               String    @default("Mediterranean Diet")
  // Training preferences that tailor recommendations (options in
  // packages/shared/tailoring.js). An empty list means "not answered";
  // equipment ["none"] means bodyweight only.
  focusAreas         String[]  @default([])
  equipment          String[]  @default([])
  limitations        String[]  @default([])
  workoutMinutes     Int?
  daysPerWeek        Int?
  role               String    @default("user") // user | creator (a coach) | admin
  birthYear          Int?
  // Shared to add friends; created on first use.
  friendCode         String?   @unique
  // Appear by first name + initial on challenge and friend leaderboards.
  showOnLeaderboards Boolean   @default(true)
  // Friends see this member's workouts in their feed (and can cheer them).
  shareActivity      Boolean   @default(true)
  // The first-week starter checklist on the home page was hidden (services/starter.js).
  starterHidden      Boolean   @default(false)
  // metric (kg, cm) or imperial (lb, ft/in), for showing and entering
  // weights and lengths. Values are stored in metric either way.
  units              String    @default("metric")
  // Billing (Stripe). plan is "plus" while the subscription is active.
  plan               String    @default("free")
  stripeCustomerId   String?   @unique
  subscriptionStatus String?
  planRenewsAt       DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  avatarUrl          String?
  // Reminders (services/reminders.js): weekdays (0 = Sunday … 6 = Saturday)
  // and a local "HH:MM" for workouts, plus an evening nudge for the streak.
  reminderDays       Int[]     @default([])
  reminderTime       String    @default("18:00")
  streakReminder     Boolean   @default(false)
  // The browser's time zone (IANA name), for reminders the server sends.
  timeZone           String?
  // Local date of the last reminder of each kind, so none is sent twice.
  workoutReminderOn  String?
  streakReminderOn   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  favorites              Favorite[]
  customImages           CustomWorkoutImage[]
  workoutLikes           WorkoutLike[]
  reviews                Review[]
  reviewLikes            ReviewLike[]
  sessions               WorkoutSession[]
  enrollments            Enrollment[]
  bodyMetrics            BodyMetric[]
  refreshTokens          RefreshToken[]
  ownPrograms            Program[]              @relation("ProgramOwner")
  coachMessages          CoachMessage[]
  aiRequests             AiRequest[]
  foods                  Food[]
  foodLogs               FoodLog[]
  waterIntake            WaterIntake[]
  progressPhotos         ProgressPhoto[]
  dailyMetrics           DailyMetric[]
  bloodPressure          BloodPressureReading[]
  externalActivities     ExternalActivity[]
  connections            Connection[]
  oauthStates            OAuthState[]
  friendRequestsSent     Friendship[]           @relation("FriendshipRequester")
  friendRequestsReceived Friendship[]           @relation("FriendshipAddressee")
  challengesCreated      Challenge[]
  challengeMemberships   ChallengeMember[]
  createdPrograms        Program[]              @relation("ProgramCreator")
  createdWorkouts        Workout[]              @relation("WorkoutCreator")
  ownWorkouts            Workout[]              @relation("WorkoutOwner")
  coachProfile           CoachProfile?
  articles               Article[]              @relation("ArticleAuthor")
  passwordResets         PasswordReset[]
  emailVerifications     EmailVerification[]
  pushSubscriptions      PushSubscription[]
  coachNotesSent         CoachNote[]            @relation("CoachNoteFrom")
  coachNotesReceived     CoachNote[]            @relation("CoachNoteTo")
  cheersGiven            Cheer[]
  readinessChecks        ReadinessCheck[]
  crewsCreated           Crew[]
  crewMemberships        CrewMember[]
  crewMessages           CrewMessage[]

  @@map("users")
}

// One row per issued refresh token, so a token can be rotated once and a
// whole family revoked when an old one is replayed.
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  family     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

// A "forgot password" link. Only a hash of the token in the emailed link is
// stored; the row is deleted once used, or when a newer link replaces it.
model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

// A "confirm your email" link sent at sign-up. Only a hash of the token is
// stored; the row is deleted once used, or when a newer link replaces it.
model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

model Workout {
  id               String   @id @default(uuid())
  slug             String   @unique
  title            String   @db.VarChar(100)
  description      String
  shortDescription String?
  category         String
  difficulty       String
  duration         Int // minutes
  calories         Int? // estimated for the whole workout
  intensity        String   @default("Moderate")
  equipment        String[]
  targetMuscles    String[]
  benefits         String[]
  // [{ stepNumber, instruction, duration, gifUrl, exerciseName, formCues, commonMistakes, breathingPattern, ... }]
  steps            Json     @default("[]")
  thumbnailUrl     String?
  videoUrl         String?
  imageGallery     String[]
  tags             String[]
  prerequisites    String[]
  cautions         String[]
  modifications    Json     @default("[]") // [{ level: 'easier' | 'harder', description }]
  restPeriod       Int      @default(30) // seconds
  sets             Int      @default(1)
  reps             Int?
  isPublished      Boolean  @default(true)
  isPremium        Boolean  @default(false)
  // Coach-written workouts go through review like coach programs.
  creatorId        String?
  status           String   @default("published") // draft | pending | published | rejected | private
  reviewNote       String?  @db.VarChar(500)
  // A member's own workout (services/myWorkouts.js): private, never in the
  // catalog. builtFrom is what they entered in the builder.
  ownerId          String?
  builtFrom        Json?
  viewCount        Int      @default(0)
  likeCount        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  creator User?         @relation("WorkoutCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  owner   User?         @relation("WorkoutOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  likes   WorkoutLike[]

  @@index([category])
  @@index([difficulty])
  @@index([creatorId, status])
  @@index([ownerId])
  @@map("workouts")
}

model WorkoutLike {
  userId      String
  workoutSlug String
  createdAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout Workout @relation(fields: [workoutSlug], references: [slug], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, workoutSlug])
  @@map("workout_likes")
}

model Exercise {
  id             String   @id @default(uuid())
  slug           String   @unique
  name           String   @db.VarChar(100)
  aliases        String[]
  category       String // Strength | Cardio | Mobility | Core | Plyometric
  trackingType   String // reps | weighted | duration | distance
  primaryMuscles String[]
  equipment      String[]
  instructions   String[]
  formCues       String[]
  commonMistakes String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("exercises")
}

model Program {
  id            String   @id @default(uuid())
  slug          String   @unique
  title         String   @db.VarChar(100)
  description   String
  level         String
  goal          String
  weeks         Int
  daysPerWeek   Int
  isPublished   Boolean  @default(true)
  // Set for a personal plan made by the plan generator; only its owner sees it.
  ownerId       String?
  // How a personal plan was generated: { goal, level, daysPerWeek, minutesPerSession, equipment }
  generatedFrom Json?
  // Creator marketplace: programs written by creators go through review.
  creatorId     String?
  status        String   @default("published") // draft | pending | published | rejected
  reviewNote    String?  @db.VarChar(500)
  // Only for PLUS members (see billing).
  isPremium     Boolean  @default(false)
  // Trained in person by the coach: members contact them to request a spot.
  inPerson      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner       User?        @relation("ProgramOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  creator     User?        @relation("ProgramCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  days        ProgramDay[]
  enrollments Enrollment[]

  @@index([ownerId])
  @@index([creatorId, status])
  @@map("programs")
}

// One scheduled day of a program. `day` is the day within the week (1-7), so
// with an enrollment start date every ProgramDay maps to a calendar date.
model ProgramDay {
  id          String  @id @default(uuid())
  programId   String
  week        Int
  day         Int
  title       String
  workoutSlug String
  notes       String?

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, week, day])
  @@map("program_days")
}

// A member's application to coach on FitGuide, and once an admin approves it
// (which gives them the creator role), their public coach profile. Contact
// details are shown to signed-in members only.
model CoachProfile {
  userId       String   @id
  status       String   @default("pending") // pending | approved | declined
  bio          String   @db.VarChar(1000)
  specialties  String[] @default([])
  contactEmail String?  @db.VarChar(200)
  phone        String?  @db.VarChar(40)
  location     String?  @db.VarChar(120)
  reviewNote   String?  @db.VarChar(500)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("coach_profiles")
}

// ─── Per-user data ───────────────────────────────────────────────────────────

model Favorite {
  userId      String
  workoutSlug String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, workoutSlug])
  @@map("favorites")
}

model CustomWorkoutImage {
  userId         String
  workoutSlug    String
  customImageUrl String   @db.VarChar(500)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, workoutSlug])
  @@map("custom_workout_images")
}

model Review {
  id              String   @id @default(uuid())
  userId          String?
  name            String   @db.VarChar(100) // author's name when posted
  userAvatar      String?
  rating          Int
  comment         String   @db.VarChar(1000)
  workoutRegiment String?  @db.VarChar(200)
  workoutSlug     String?
  beforeImage     String?
  afterImage      String?
  likes           Int      @default(0)
  createdAt       DateTime @default(now())

  user    User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  likedBy ReviewLike[]

  // One review per user per workout (NULL workoutSlug = general review).
  @@unique([userId, workoutSlug])
  @@index([workoutSlug])
  @@map("reviews")
}

model ReviewLike {
  reviewId  String
  userId    String
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
  @@map("review_likes")
}

model WorkoutSession {
  id              String   @id @default(uuid())
  userId          String
  workoutSlug     String
  workoutTitle    String // snapshot, so history survives catalog edits
  category        String?
  status          String   @default("completed") // completed | partial
  startedAt       DateTime
  completedAt     DateTime
  durationSec     Int
  calories        Int      @default(0)
  stepsCompleted  Int      @default(0)
  totalSteps      Int      @default(0)
  perceivedEffort Int? // session RPE 1-10
  // Heart rate from the wearer's watch or strap (Apple Health / Health
  // Connect); when present, calories come from it (calorieSource heart_rate).
  avgHr           Int?
  maxHr           Int?
  calorieSource   String   @default("estimate") // estimate | heart_rate
  notes           String   @default("") @db.VarChar(1000)
  // Set when the session was a scheduled program day.
  enrollmentId    String?
  programWeek     Int?
  programDay      Int?
  // Id the client made up for this session, so sending it again (offline
  // sync, a retry after a lost response) doesn't save it twice.
  clientId        String?  @db.VarChar(64)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  sets       SetLog[]
  cheers     Cheer[]

  @@unique([userId, clientId])
  @@index([userId, completedAt(sort: Desc)])
  @@map("workout_sessions")
}

// One logged set (or timed step) of an exercise within a session.
model SetLog {
  id           String  @id @default(uuid())
  sessionId    String
  position     Int // order within the session
  exerciseSlug String? // matched to the exercise library when possible
  exerciseName String  @db.VarChar(200)
  setNumber    Int?
  reps         Int?
  weightKg     Float?
  durationSec  Int?
  distanceM    Float?
  rpe          Int?

  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, position])
  @@map("set_logs")
}

model Enrollment {
  id          String    @id @default(uuid())
  userId      String
  programSlug String
  startDate   String    @db.VarChar(10) // YYYY-MM-DD, user's local date of week 1 day 1
  status      String    @default("active") // active | completed | abandoned
  endedAt     DateTime?
  // Catch-ups the member accepted (services/planSuggestions.js): each
  // { week, day, days } moves that scheduled day and every later one `days`
  // later than the start date alone would put them.
  shifts      Json      @default("[]")
  // A kind of plan suggestion the member said no to, hidden until this local date.
  hiddenSuggestion      String?
  hiddenSuggestionUntil String?   @db.VarChar(10)
  // The member lets the program's coach see how they're doing and send
  // them notes (routes/creator.js clients). Off until they turn it on.
  shareWithCoach        Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  program       Program          @relation(fields: [programSlug], references: [slug], onUpdate: Cascade)
  completedDays EnrollmentDay[]
  sessions      WorkoutSession[]
  coachNotes    CoachNote[]

  @@index([userId, status])
  @@map("enrollments")
}

model EnrollmentDay {
  enrollmentId String
  week         Int
  day          Int
  sessionId    String
  completedAt  DateTime

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@id([enrollmentId, week, day])
  @@map("enrollment_days")
}

// A short note from a program's coach to a member who shares their progress
// with them; shown to the member until they mark it read.
model CoachNote {
  id           String    @id @default(uuid())
  coachId      String
  userId       String
  enrollmentId String
  text         String    @db.VarChar(500)
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  coach      User       @relation("CoachNoteFrom", fields: [coachId], references: [id], onDelete: Cascade)
  user       User       @relation("CoachNoteTo", fields: [userId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([enrollmentId, createdAt])
  @@map("coach_notes")
}

// Body measurements logged over time; one entry per user per day.
model BodyMetric {
  id         String   @id @default(uuid())
  userId     String
  date       String   @db.VarChar(10) // YYYY-MM-DD, user's local date
  weightKg   Float?
  bodyFatPct Float?
  waistCm    Float?
  chestCm    Float?
  hipsCm     Float?
  armCm      Float?
  thighCm    Float?
  notes      String   @default("") @db.VarChar(500)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("body_metrics")
}

// ─── AI coach ────────────────────────────────────────────────────────────────

// One coach conversation per user, stored append-only: `content` holds the
// exact Messages API content (including thinking and tool blocks), so the
// history is replayed to the model unchanged.
model CoachMessage {
  id        String   @id @default(uuid())
  userId    String
  role      String // user | assistant | system
  content   Json
  // Text shown in the chat UI (user text, or the assistant's final reply).
  display   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("coach_messages")
}

// ─── Nutrition ───────────────────────────────────────────────────────────────

// Catalog foods (ownerId null) and foods a user added for themselves.
// Nutrition values are per serving.
model Food {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String   @db.VarChar(120)
  category     String // protein | legume | grain | fruit | vegetable | fat | dairy | snack | custom
  servingLabel String   @db.VarChar(60)
  servingSize  Float
  servingUnit  String   @default("g")
  calories     Float
  protein      Float
  carbs        Float
  fat          Float
  fiber        Float    @default(0)
  diets        String[] // diets the food fits: mediterranean, keto, paleo, flexible, vegetarian, vegan
  ownerId      String?
  createdAt    DateTime @default(now())

  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("foods")
}

// One logged food. Name and totals are copied in, so the log survives catalog edits.
model FoodLog {
  id        String   @id @default(uuid())
  userId    String
  date      String   @db.VarChar(10) // YYYY-MM-DD, user's local date
  meal      String // breakfast | lunch | dinner | snack
  foodSlug  String?
  name      String   @db.VarChar(120)
  servings  Float
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("food_logs")
}

// ─── Wearables and health data ───────────────────────────────────────────────

// Daily health numbers from one source (manual, csv, fitbit, strava). The
// Progress page shows the most specific value per day.
model DailyMetric {
  id             String   @id @default(uuid())
  userId         String
  date           String   @db.VarChar(10) // YYYY-MM-DD, user's local date
  source         String // manual | apple_health | health_connect | fitbit | csv | strava
  steps          Int?
  restingHr      Int? // beats per minute
  sleepMinutes   Int?
  activeCalories Int?
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, source])
  @@index([userId, date])
  @@map("daily_metrics")
}

// The morning check-in behind the daily readiness score (services/readiness.js):
// how the member feels, 1 (low) to 5 (high). One per local date.
model ReadinessCheck {
  userId    String
  date      String   @db.VarChar(10)
  energy    Int
  soreness  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
  @@map("readiness_checks")
}

// One blood pressure reading: typed in, or from a cuff that writes to Apple
// Health / Health Connect (synced by the mobile app).
model BloodPressureReading {
  id         String   @id @default(uuid())
  userId     String
  measuredAt DateTime
  date       String   @db.VarChar(10) // YYYY-MM-DD, user's local date
  systolic   Int // mmHg
  diastolic  Int // mmHg
  pulse      Int? // beats per minute
  source     String // manual | apple_health | health_connect
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, measuredAt])
  @@index([userId, measuredAt(sort: Desc)])
  @@map("blood_pressure_readings")
}

// A workout recorded by another service (e.g. a Strava run). Counts toward
// activity and streaks, but not personal records.
model ExternalActivity {
  id          String   @id @default(uuid())
  userId      String
  provider    String
  externalId  String
  type        String // run, ride, walk, swim, workout, ...
  name        String   @db.VarChar(200)
  startedAt   DateTime
  durationSec Int
  distanceM   Float?
  calories    Int?
  avgHr       Int?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([userId, startedAt])
  @@map("external_activities")
}

// A linked account at a wearable/fitness service. Tokens are encrypted.
model Connection {
  id             String    @id @default(uuid())
  userId         String
  provider       String // strava | fitbit
  externalUserId String?
  accessToken    String // AES-256-GCM, see utils/crypto.js
  refreshToken   String?
  expiresAt      DateTime?
  scopes         String?
  lastSyncAt     DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("connections")
}

// Pending OAuth sign-ins: the state parameter and PKCE verifier stay here,
// never in the browser.
model OAuthState {
  id           String   @id // the random state value
  userId       String
  provider     String
  codeVerifier String
  expiresAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("oauth_states")
}

// ─── Community ───────────────────────────────────────────────────────────────

model Friendship {
  id          String   @id @default(uuid())
  requesterId String
  addresseeId String
  status      String   @default("pending") // pending | accepted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@map("friendships")
}

// A friend's cheer on a workout in the feed; one per person per workout.
model Cheer {
  sessionId String
  userId    String
  createdAt DateTime @default(now())

  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionId, userId])
  @@index([userId])
  @@map("cheers")
}

// A time-boxed competition. Scores come from logged data in the date range.
model Challenge {
  id          String   @id @default(uuid())
  title       String   @db.VarChar(100)
  description String   @default("") @db.VarChar(500)
  metric      String // sessions | minutes | activeDays | steps
  target      Int? // optional goal, e.g. 20 sessions
  startDate   String   @db.VarChar(10) // YYYY-MM-DD (UTC)
  endDate     String   @db.VarChar(10)
  visibility  String // public | friends | private
  joinCode    String   @unique
  creatorId   String?
  createdAt   DateTime @default(now())

  creator User?             @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  members ChallengeMember[]

  @@index([visibility, endDate])
  @@map("challenges")
}

model ChallengeMember {
  challengeId String
  userId      String
  joinedAt    DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([challengeId, userId])
  @@index([userId])
  @@map("challenge_members")
}

// A crew: a small invite-only group (up to 8) with a shared weekly goal,
// its members' workouts and a chat (services/crews.js).
model Crew {
  id         String   @id @default(uuid())
  name       String   @db.VarChar(50)
  // Workouts a week, by the whole crew together.
  weeklyGoal Int
  inviteCode String   @unique
  creatorId  String?
  createdAt  DateTime @default(now())

  creator  User?         @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  members  CrewMember[]
  messages CrewMessage[]

  @@map("crews")
}

model CrewMember {
  crewId   String
  userId   String
  role     String   @default("member") // owner | member
  joinedAt DateTime @default(now())

  crew Crew @relation(fields: [crewId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([crewId, userId])
  @@index([userId])
  @@map("crew_members")
}

model CrewMessage {
  id        String   @id @default(uuid())
  crewId    String
  userId    String
  text      String   @db.VarChar(500)
  createdAt DateTime @default(now())

  crew Crew @relation(fields: [crewId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([crewId, createdAt])
  @@map("crew_messages")
}

// Stripe webhook events already handled (Stripe can deliver an event twice).
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@map("stripe_events")
}

// ─── Analytics ───────────────────────────────────────────────────────────────

// First-party, cookie-free usage events. No IP address, user id or user
// agent is stored; visitorId is a random id kept in the browser's storage.
model AnalyticsEvent {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(40)
  path      String?  @db.VarChar(200)
  visitorId String?  @db.VarChar(40)
  device    String?  @db.VarChar(10) // mobile | desktop
  props     Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([name, createdAt])
  @@map("analytics_events")
}

// An article written by a coach or an admin, shown on the home page next to
// the built-in guides. Coaches' articles are reviewed before they're
// published. The body is structured (key points, then sections of
// paragraphs with an optional tip) so the website and the app lay it out
// the same way.
model Article {
  id            String    @id @default(uuid())
  slug          String    @unique
  title         String    @db.VarChar(160)
  description   String    @db.VarChar(300)
  category      String // TRAINING | NUTRITION | RECOVERY
  coverImageUrl String?   @db.VarChar(500)
  takeaways     String[]
  sections      Json // [{ heading, paragraphs: string[], tip? }]
  readMinutes   Int
  authorId      String?
  status        String    @default("draft") // draft | pending | published | rejected
  reviewNote    String?   @db.VarChar(500)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  author User? @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt(sort: Desc)])
  @@index([authorId])
  @@map("articles")
}

/// One use of an AI feature (reading a meal from a photo or a description),
/// counted for the daily allowance. Only the kind and time are kept: never
/// the photo or the text.
model AiRequest {
  id        String   @id @default(uuid())
  userId    String
  kind      String // meal_photo | meal_text | swap | feedback | checkin | writing
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@map("ai_requests")
}

/// A browser that turned on reminders (Web Push). Phones schedule their own.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Water drunk on a day (the user's local date), in ml.
model WaterIntake {
  id        String   @id @default(uuid())
  userId    String
  date      String   @db.VarChar(10)
  ml        Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("water_intake")
}

/// A private progress photo: only its owner can see it (served by the API,
/// never from public storage).
model ProgressPhoto {
  id        String   @id @default(uuid())
  userId    String
  date      String   @db.VarChar(10) // the user's local date
  fileKey   String   @unique // private storage key
  note      String   @default("") @db.VarChar(200)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("progress_photos")
}
