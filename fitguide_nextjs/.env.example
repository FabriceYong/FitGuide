# Copy to .env and fill in. Everything here is shipped to the browser, so never
# put server secrets (JWT, database, private API keys) in this file; those
# belong in fitguide_api/.env.

# FitGuide API base URL
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# Unsplash API access key (for dynamic workout images)
# Get a free key at https://unsplash.com/developers
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=your_unsplash_api_key_here
